{
  "name": "docuguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "db:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File database/postgres/run_all.ps1",
    "db:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File database/postgres/run_all.ps1 -Reset",
    "db:auth": "powershell -NoProfile -ExecutionPolicy Bypass -File database/postgres/run_all.ps1 -AuthOnly",
    "db:documents": "powershell -NoProfile -ExecutionPolicy Bypass -File database/postgres/run_all.ps1 -DocumentsOnly",
    "db:mongo:indexes": "node database/mongo/indexes.js",
    "db:mongo:seed": "node database/mongo/seed.js",
    "db:mongo:analytics": "node database/mongo/aggregations.js",
    "db:embeddings": "npm run embeddings:seed --workspace backend",
    "model:check": "npm run build --workspace backend && npm run embedding:check --workspace backend",
    "db:test": "powershell -NoProfile -ExecutionPolicy Bypass -File database/postgres/run_all.ps1 -TestOnly",
    "db:rebuild-test": "powershell -NoProfile -ExecutionPolicy Bypass -File database/postgres/run_isolated_validation.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
