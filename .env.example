# Copy this file to .env for local development. Never commit .env.
POSTGRES_DB=docuguard
POSTGRES_USER=docuguard_app
POSTGRES_PASSWORD=change-me-local-only
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=docuguard
PG_USER=docuguard_runtime
PG_PASSWORD=change-me-runtime-only
MONGO_ROOT_USERNAME=docuguard_root
MONGO_ROOT_PASSWORD=change-me-local-only
MONGO_URI=mongodb://docuguard_root:change-me-local-only@localhost:27017/?authSource=admin
MONGO_DB=docuguard
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=4000
UPLOAD_DIR=./uploads
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
